logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.*.local
.env.sb

# Build output
.aws-sam/

# dependencies
node_modules/
**/node_modules/

# Scripts folder (local use only)
backend/scripts/

# Local deploy parameter overrides — real bucket/table/domain names, kept out of git
backend/.deploy-params.*.sh

# Secrets and sensitive data
backend/keys.json
backend/options_keys.json
backend/scripts/keys.json
backend/scripts/keys.ndjson
backend/scripts/options_keys.json
backend/scripts/batches_aa
backend/scripts/*.xlsx
backend/scripts/*.csv
backend/receipt-extractor/*.jpg
backend/receipt-extractor/*.jpeg
backend/receipt-extractor/*.png

# Local-only files
local/

# Python virtual environments
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc

# Architecture Diagrams
**/*.drawio

# Markdown and HTML files (anywhere in the project)
**/*.md
**/*.html

# Exception: agent system prompts are markdown files the Lambda actually
# reads at runtime (Part 5/6 plan's "versioned prompt files" convention) —
# not planning/notes docs. Without this, they'd be silently excluded from
# every deploy and the function would crash with FileNotFoundError.
!backend/ai-services/**/prompts/*.md

# Claude Code local memory (never push)
.claude/

# GitIgnore
.gitignore

# MS Office Documents
**/*.docx
**/*.xlsx
**/*.pptx
